{
  "name": "excave",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter @excave/web --filter @excave/server dev",
    "dev:web": "pnpm --filter @excave/web dev",
    "dev:server": "pnpm --filter @excave/server dev",
    "build": "pnpm --filter @excave/shared build && pnpm --filter @excave/server build && pnpm --filter @excave/web build",
    "typecheck": "pnpm -r --filter @excave/shared --filter @excave/server --filter @excave/web typecheck",
    "test": "pnpm -r --filter @excave/shared --filter @excave/server --filter @excave/web --if-present test"
  }
}
